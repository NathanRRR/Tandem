# Copier ce fichier en .env (jamais commité) et remplir avec de vraies valeurs.

# Connexion utilisée par `npm run dev`/`db:generate`/`db:migrate`/`db:seed` sur l'hôte
# (le conteneur `app`, lui, se connecte via `db:3306` — voir docker-compose.yml).
DATABASE_URL=mysql://budget:budget@localhost:3308/budget

# Identifiants du conteneur MariaDB (docker-compose.yml, service `db`).
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=budget
MARIADB_USER=budget
MARIADB_PASSWORD=change-me

# Secret de session (iron-session) : chaîne aléatoire d'au moins 32 caractères.
SESSION_SECRET=change-me-to-a-random-32-char-string

# Les 2 comptes du foyer — créés par `npm run db:seed`, pas d'inscription publique.
USER_A_USERNAME=nathan
USER_A_PASSWORD=change-me
USER_A_NAME=Nathan
USER_A_INCOME_CENTS=245000

USER_B_USERNAME=lizzie
USER_B_PASSWORD=change-me
USER_B_NAME=Lizzie
USER_B_INCOME_CENTS=195000
